# Set these non-secret options in the launching shell. The CLI does not load this file.
NISAR_APP_NAME=nova-frontier-model
NISAR_VOLUME=nova-frontier-chip-cache
NISAR_STATE_DICT=nova-frontier-model-jobs
NISAR_EARTHDATA_SECRET=nova-frontier-earthdata
# The secret supplies EARTHDATA_TOKEN inside the Modal science worker.
